{
  "name": "objection",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @objection/web dev",
    "build": "pnpm --filter @objection/web build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "lefthook": "2.1.14",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
